--TEST--
GC 037: gc_status()
--INI--
zend.enable_gc = 1
--FILE--
<?php
$a = array();
$a[] =& $a;
unset($a);
var_dump(gc_status());
gc_collect_cycles();
gc_collect_cycles();
var_dump(gc_status());
?>

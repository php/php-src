--upload-boundary--
--FILE--
<?php
session_start();
$progress = $_SESSION['upload_progress_trailing'];
var_dump(strlen($_POST['trailing']) > 8192);
var_dump($progress['done']);
var_dump($progress['bytes_processed'] === (int) $_SERVER['CONTENT_LENGTH']);
var_dump($progress['content_length'] === (int) $_SERVER['CONTENT_LENGTH']);
foreach ($progress['files'] as $file) {
    var_dump($file['done'], $file['bytes_processed'], $file['error']);
}
session_destroy();
?>

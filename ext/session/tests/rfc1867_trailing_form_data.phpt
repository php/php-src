--TEST--
Upload progress counts trailing form data after separating the progress array
--EXTENSIONS--
session
--INI--
file_uploads=1
session.save_path=
session.save_handler=files
session.use_strict_mode=0
session.use_cookies=1
session.use_only_cookies=1
session.upload_progress.enabled=1
session.upload_progress.cleanup=0
session.upload_progress.freq=0
session.upload_progress.min_freq=0
--SKIPIF--
<?php include('skipif.inc'); ?>
--COOKIE--
PHPSESSID=rfc1867-trailing-form-data
--POST_RAW--
Content-Type: multipart/form-data; boundary=upload-boundary
--upload-boundary
Content-Disposition: form-data; name="PHP_SESSION_UPLOAD_PROGRESS"

trailing
--upload-boundary
Content-Disposition: form-data; name="file1"; filename="first.txt"

A
--upload-boundary
Content-Disposition: form-data; name="file2"; filename="second.txt"

BC
--upload-boundary
Content-Disposition: form-data; name="trailing"


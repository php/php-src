         +0.999999999 /          3 =          +0.333333333
         +0.999999999 /          4 =          +0.249999999
         +0.999999999 /  999999999 =          +0.000000001
         +0.999999999 / 1000000000 =          +0.000000000
         +0.999999999 / 2147483647 =          +0.000000000
========

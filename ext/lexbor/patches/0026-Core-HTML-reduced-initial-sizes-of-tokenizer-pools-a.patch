From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nicolas Grekas <nicolas.grekas@gmail.com>
Date: Sun, 27 Sep 2026 19:49:58 +0200
Subject: [PATCH 26/26] Core/HTML: reduced initial sizes of tokenizer pools and
 mraw cache.

The HTML tokenizer preallocated 4096 tokens and 4096 token attributes,
and every lexbor_mraw_t preallocated 512 entries for its cache of freed
blocks. A document parser has 7 mraws, so about 1 MB was allocated
before parsing a single byte.

The tree builder uses a single token, and all these pools grow on
demand, so they now start with 16 tokens, 256 attributes and 64 cache
entries.

The initial sizes can be set at build time by defining
LXB_HTML_TKZ_TOKEN_POOL_SIZE, LXB_HTML_TKZ_ATTR_POOL_SIZE and
LEXBOR_MRAW_CACHE_SIZE, e.g. with -D compiler flags.

This is lexbor/lexbor#427.
---
 source/lexbor/core/mraw.c      |  6 +++++-
 source/lexbor/html/tokenizer.c | 14 ++++++++++++--
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/source/lexbor/core/mraw.c b/source/lexbor/core/mraw.c
index c990405..30faca6 100644
--- a/source/lexbor/core/mraw.c
+++ b/source/lexbor/core/mraw.c
@@ -11,6 +11,10 @@
     #include <sanitizer/asan_interface.h>
 #endif
 
+#ifndef LEXBOR_MRAW_CACHE_SIZE
+    #define LEXBOR_MRAW_CACHE_SIZE 64
+#endif
+
 
 #define lexbor_mraw_meta_set(data, size)                                       \
     do {                                                                       \
@@ -62,7 +66,7 @@ lexbor_mraw_init(lexbor_mraw_t *mraw, size_t chunk_size)
     /* Cache */
     mraw->cache = lexbor_bst_create();
 
-    status = lexbor_bst_init(mraw->cache, 512);
+    status = lexbor_bst_init(mraw->cache, LEXBOR_MRAW_CACHE_SIZE);
     if (status) {
         return status;
     }
diff --git a/source/lexbor/html/tokenizer.c b/source/lexbor/html/tokenizer.c
index 1d9f378..2193146 100644
--- a/source/lexbor/html/tokenizer.c
+++ b/source/lexbor/html/tokenizer.c
@@ -20,6 +20,14 @@
 
 #define LXB_HTML_TKZ_TEMP_SIZE (4096 * 4)
 
+#ifndef LXB_HTML_TKZ_TOKEN_POOL_SIZE
+    #define LXB_HTML_TKZ_TOKEN_POOL_SIZE 16
+#endif
+
+#ifndef LXB_HTML_TKZ_ATTR_POOL_SIZE
+    #define LXB_HTML_TKZ_ATTR_POOL_SIZE 256
+#endif
+
 
 enum {
     LXB_HTML_TOKENIZER_OPT_TAGS_SELF       = 1 << 0,
@@ -63,14 +71,16 @@ lxb_html_tokenizer_init(lxb_html_tokenizer_t *tkz)
 
     tkz->dobj_token = lexbor_dobject_create();
     status = lexbor_dobject_init(tkz->dobj_token,
-                                 4096, sizeof(lxb_html_token_t));
+                                 LXB_HTML_TKZ_TOKEN_POOL_SIZE,
+                                 sizeof(lxb_html_token_t));
     if (status != LXB_STATUS_OK) {
         return status;
     }
 
     /* Init Token Attributes */
     tkz->dobj_token_attr = lexbor_dobject_create();
-    status = lexbor_dobject_init(tkz->dobj_token_attr, 4096,
+    status = lexbor_dobject_init(tkz->dobj_token_attr,
+                                 LXB_HTML_TKZ_ATTR_POOL_SIZE,
                                  sizeof(lxb_html_token_attr_t));
     if (status != LXB_STATUS_OK) {
         return status;

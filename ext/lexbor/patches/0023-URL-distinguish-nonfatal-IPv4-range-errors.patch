From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Akouh Mohamed Amine <Akouhroot@gmail.com>
Date: Thu, 19 Nov 2026 23:00:00 +0000
Subject: [PATCH] URL: distinguish nonfatal IPv4 range errors

A final part may occupy multiple octets. Keep the validation error, but
give consumers a way to distinguish it from an IPv4 parse failure.

---
diff --git a/source/lexbor/url/url.c b/source/lexbor/url/url.c
index 146f0bda..01a3708b 100644
--- a/source/lexbor/url/url.c
+++ b/source/lexbor/url/url.c
@@ -3542,7 +3542,7 @@ lxb_url_host_idna_cb(const lxb_char_t *data, size_t len, void *ctx)
 lxb_inline lxb_status_t
 lxb_url_ipv4_append(lxb_url_parser_t *parser, const lxb_char_t *data,
                     const lxb_char_t *end, uint64_t *ipv,
-                    int *out_of, unsigned i)
+                    uint64_t limit, unsigned i)
 {
     lxb_status_t status;
     lxb_url_error_type_t type;
@@ -3563,15 +3563,12 @@ lxb_url_ipv4_append(lxb_url_parser_t *parser, const lxb_char_t *data,
     }
 
     if (ipv[i] > 255) {
-        status = lxb_url_log_append(parser, data,
-                                    LXB_URL_ERROR_TYPE_IPV4_OUT_OF_RANGE_PART);
+        type = ipv[i] < limit ? LXB_URL_ERROR_TYPE_IPV4_LARGE_FINAL_PART
+                              : LXB_URL_ERROR_TYPE_IPV4_OUT_OF_RANGE_PART;
+        status = lxb_url_log_append(parser, data, type);
         if (status != LXB_STATUS_OK) {
             return status;
         }
-
-        if (*out_of != -1) {
-            *out_of = (int) i;
-        }
     }
 
     return LXB_STATUS_OK;
@@ -3590,7 +3587,6 @@ static lxb_status_t
 lxb_url_ipv4_parse(lxb_url_parser_t *parser, const lxb_char_t *data,
                    const lxb_char_t *end, uint32_t *ipv4)
 {
-    int out_of;
     uint32_t ip;
     uint64_t parts[5];
     unsigned i;
@@ -3607,7 +3603,6 @@ lxb_url_ipv4_parse(lxb_url_parser_t *parser, const lxb_char_t *data,
     i = 0;
     p = data;
     begin = data;
-    out_of = -1;
 
     /* Let's make the compiler happy. */
 
@@ -3620,7 +3615,9 @@ lxb_url_ipv4_parse(lxb_url_parser_t *parser, const lxb_char_t *data,
                 goto failed;
             }
 
-            status = lxb_url_ipv4_append(parser, begin, p, parts, &out_of, ++i);
+            ++i;
+            status = lxb_url_ipv4_append(parser, begin, p, parts,
+                                         p + 1 == end ? st[5 - i] : 256, i);
             if (status != LXB_STATUS_OK) {
                 return status;
             }
@@ -3637,7 +3634,8 @@ lxb_url_ipv4_parse(lxb_url_parser_t *parser, const lxb_char_t *data,
             goto failed;
         }
 
-        status = lxb_url_ipv4_append(parser, begin, p, parts, &out_of, ++i);
+        ++i;
+        status = lxb_url_ipv4_append(parser, begin, p, parts, st[5 - i], i);
         if (status != LXB_STATUS_OK) {
             return status;
         }
@@ -3650,10 +3648,6 @@ lxb_url_ipv4_parse(lxb_url_parser_t *parser, const lxb_char_t *data,
         }
     }
 
-    if (out_of != -1 && out_of != (int) i) {
-        return LXB_STATUS_ERROR_OVERFLOW;
-    }
-
     if (parts[i] >= st[5 - i]) {
         return LXB_STATUS_ERROR_OVERFLOW;
     }
diff --git a/source/lexbor/url/url.h b/source/lexbor/url/url.h
index b9e4973a..917d9590 100644
--- a/source/lexbor/url/url.h
+++ b/source/lexbor/url/url.h
@@ -51,6 +51,7 @@ typedef enum {
     LXB_URL_ERROR_TYPE_PORT_INVALID,
     LXB_URL_ERROR_TYPE_FILE_INVALID_WINDOWS_DRIVE_LETTER,
     LXB_URL_ERROR_TYPE_FILE_INVALID_WINDOWS_DRIVE_LETTER_HOST,
+    LXB_URL_ERROR_TYPE_IPV4_LARGE_FINAL_PART,
     LXB_URL_ERROR_TYPE__LAST_ENTRY
 }
 lxb_url_error_type_t;

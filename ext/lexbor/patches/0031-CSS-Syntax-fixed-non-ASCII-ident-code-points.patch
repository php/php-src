From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Borisov <lex.borisov@gmail.com>
Date: Fri, 10 Jul 2026 00:39:54 +0300
Subject: [PATCH 31/31] CSS::Syntax: fixed non-ASCII ident code points.

Updated generated non-ASCII ident ranges to match CSS Syntax:
included U+200C/U+200D and U+203F/U+2040, and stopped the
U+3001 range at U+D7FF to exclude surrogate code points.
---
 source/lexbor/css/syntax/state.c | 45 ++++++++++++++++++--------------
 1 file changed, 25 insertions(+), 20 deletions(-)

diff --git a/source/lexbor/css/syntax/state.c b/source/lexbor/css/syntax/state.c
index a1db76a..5b694e9 100644
--- a/source/lexbor/css/syntax/state.c
+++ b/source/lexbor/css/syntax/state.c
@@ -149,15 +149,10 @@ lxb_css_syntax_state_valid_escape(const lxb_char_t *data,
 lxb_inline bool
 lxb_css_syntax_state_non_ascii(lxb_codepoint_t cp)
 {
-    /*
-     * Actually here the comparison should be to U+D7FF.
-     * But we capture surrogate pairs, they will be further converted to 0xFFFD.
-     */
-
     /* This code is generated by the file utils/lexbor/css/syntax/non_ascii.pl */
 
     /* Begin */
-    if (cp <= 0x218F) {
+    if (cp <= 0x2040) {
         if (cp <= 0x00F6) {
             if (cp >= 0x00B7 && cp <= 0x00B7) {
                 return true;
@@ -172,36 +167,46 @@ lxb_css_syntax_state_non_ascii(lxb_codepoint_t cp)
             }
         }
         else if (cp >= 0x00F8) {
-            if (cp <= 0x037D) {
-                return true;
+            if (cp <= 0x1FFF) {
+                if (cp <= 0x037D) {
+                    return true;
+                }
+                else if (cp >= 0x037F) {
+                    return true;
+                }
             }
-            else if (cp >= 0x037F) {
-                if (cp <= 0x1FFF) {
+            else if (cp >= 0x200C) {
+                if (cp <= 0x200D) {
                     return true;
                 }
-                else if (cp >= 0x2070) {
+                else if (cp >= 0x203F) {
                     return true;
                 }
             }
         }
     }
-    else if (cp >= 0x2C00) {
-        if (cp <= 0xFDCF) {
-            if (cp <= 0x2FEF) {
+    else if (cp >= 0x2070) {
+        if (cp <= 0xD7FF) {
+            if (cp <= 0x218F) {
                 return true;
             }
-            else if (cp >= 0x3001) {
-                if (cp <= 0xDFFF) {
+            else if (cp >= 0x2C00) {
+                if (cp <= 0x2FEF) {
                     return true;
                 }
-                else if (cp >= 0xF900) {
+                else if (cp >= 0x3001) {
                     return true;
                 }
             }
         }
-        else if (cp >= 0xFDF0) {
+        else if (cp >= 0xF900) {
             if (cp <= 0xFFFD) {
-                return true;
+                if (cp <= 0xFDCF) {
+                    return true;
+                }
+                else if (cp >= 0xFDF0) {
+                    return true;
+                }
             }
             else if (cp >= 0x10000) {
                 if (cp <= 0x10FFFF) {
@@ -212,7 +217,7 @@ lxb_css_syntax_state_non_ascii(lxb_codepoint_t cp)
     }
     /* End */
 
-    return cp == 0x200C || cp == 0x200D || cp == 0x203F || cp == 0x2040;
+    return false;
 }
 
 lxb_inline bool

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Borisov <lex.borisov@gmail.com>
Date: Sat, 20 Jun 2026 15:39:44 +0400
Subject: [PATCH 28/31] CSS::Syntax: fixed non-ASCII ident code point ranges.

By specification https://drafts.csswg.org/css-syntax/#non-ascii-ident-code-point.

Per report from Jon Surrell (@sirreal).

This relates to #382 issue on GitHub.
---
 source/lexbor/css/syntax/state.c | 41 ++++++++++++++++++++++----------
 1 file changed, 28 insertions(+), 13 deletions(-)

diff --git a/source/lexbor/css/syntax/state.c b/source/lexbor/css/syntax/state.c
index a93731e..a011c5a 100644
--- a/source/lexbor/css/syntax/state.c
+++ b/source/lexbor/css/syntax/state.c
@@ -165,31 +165,46 @@ lxb_css_syntax_state_non_ascii(lxb_codepoint_t cp)
     /* This code is generated by the file utils/lexbor/css/syntax/non_ascii.pl */
 
     /* Begin */
-    if (cp <= 0x2FEF) {
-        if (cp <= 0x1FFF) {
-            if (cp >= 0x00F8 && cp < 0x037D) {
+    if (cp <= 0x218F) {
+        if (cp <= 0x00F6) {
+            if (cp >= 0x00B7 && cp <= 0x00B7) {
                 return true;
             }
-            else if (cp >= 0x037F) {
-                return true;
+            else if (cp >= 0x00C0) {
+                if (cp <= 0x00D6) {
+                    return true;
+                }
+                else if (cp >= 0x00D8) {
+                    return true;
+                }
             }
         }
-        else if (cp >= 0x2070) {
-            if (cp <= 0x218F) {
+        else if (cp >= 0x00F8) {
+            if (cp <= 0x037D) {
                 return true;
             }
-            else if (cp >= 0x2C00) {
-                return true;
+            else if (cp >= 0x037F) {
+                if (cp <= 0x1FFF) {
+                    return true;
+                }
+                else if (cp >= 0x2070) {
+                    return true;
+                }
             }
         }
     }
-    else if (cp >= 0x3001) {
+    else if (cp >= 0x2C00) {
         if (cp <= 0xFDCF) {
-            if (cp <= 0xDFFF) {
+            if (cp <= 0x2FEF) {
                 return true;
             }
-            else if (cp >= 0xF900) {
-                return true;
+            else if (cp >= 0x3001) {
+                if (cp <= 0xDFFF) {
+                    return true;
+                }
+                else if (cp >= 0xF900) {
+                    return true;
+                }
             }
         }
         else if (cp >= 0xFDF0) {

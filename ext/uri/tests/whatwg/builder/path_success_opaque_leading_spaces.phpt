--TEST--
Test Uri\WhatWg\UrlBuilder::setPath() - success - leading spaces in opaque path
--FILE--
<?php

$errors = [];

$url = new Uri\WhatWg\UrlBuilder()
    ->setScheme('foo')
    ->setPath('  abc')
    ->build(null, $errors);

var_dump($url->toAsciiString());
var_dump($url);
var_dump($errors);
var_dump($url->equals(new Uri\WhatWg\Url($url->toAsciiString())));

?>
--EXPECTF--
string(9) "foo:  abc"

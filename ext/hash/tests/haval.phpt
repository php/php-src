--TEST--
Hash: HAVAL algorithm
--FILE--
<?php
// Archived source: https://web.archive.org/web/20150111210116/http://labs.calyptix.com/haval.php
// Same test vectors also exist in HAVAL.ZIP at https://www.schneier.com/books/applied-cryptography-source/
echo "*** HAVAL 1.1 reference ***\n";
$vectors = [
	"",
	"a",
	"HAVAL",
	"0123456789",
	"abcdefghijklmnopqrstuvwxyz",
	"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
	// This is the pi.frac file in the source
	"243F6A8885A308D313198A2E03707344A4093822299F31D0082EFA98EC4E6C89452821E638D01377BE5466CF34E90C6CC0AC29B7C97C50DD3F84D5B5B54709179216D5D98979FB1BD1310BA698DFB5AC" .
	"2FFD72DBD01ADFB7B8E1AFED6A267E96BA7C9045F12C7F9924A19947B3916CF70801F2E2858EFC16636920D871574E69A458FEA3F4933D7E0D95748F728EB658718BCD5882154AEE7B54A41DC25A59B5\n"
];

for ($pass = 3; $pass <= 5; $pass++) {
	for ($bits = 128; $bits <= 256; $bits += 32) {
		$algo = "haval{$bits},{$pass}";
		foreach ($vectors as $vector) {
			echo "{$algo}: ", hash($algo, $vector), "\n";
		}
	}
}
?>

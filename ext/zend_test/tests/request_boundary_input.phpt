--TEST--
Request boundary keeps a php://input stream from reading the body of the next request
--EXTENSIONS--
zend_test
--INI--
enable_post_data_reading=0
--POST_RAW--
Content-Type: application/unknown

--FILE--
<?php
$input = fopen('php://input', 'r');
var_dump(fread($input, 4));

zend_test_request_boundary();

$rest = stream_get_contents($input);
var_dump(strlen($rest), trim($rest, 'a'));
?>
--EXPECTF--
string(4) "aaaa"
%Aint(8188)
string(0) ""

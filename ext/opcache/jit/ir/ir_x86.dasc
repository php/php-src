||	} else {
||		IR_ASSERT(type == IR_FLOAT);
|		op..s xmm(op1-IR_REG_FP_FIRST), xmm(op2-IR_REG_FP_FIRST), xmm(op3-IR_REG_FP_FIRST)
||	}

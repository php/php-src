|.macro ASM_REG_IMM_OP, op, type, op1, op2
||	switch (ir_type_size[type]) {
|| 		default:
||			IR_ASSERT(0);
||		case 1:
|			op Rb(op1), (op2 & 0xff)
||			break;
||		case 2:
|			op Rw(op1), (op2 & 0xffff)
|| 			break;
||		case 4:
|			op Rd(op1), op2
|| 			break;
|.if X64
||		case 8:
|			op Rq(op1), op2
|| 			break;
|.endif
||	}
|.endmacro


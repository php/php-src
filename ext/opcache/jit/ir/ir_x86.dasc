||		} else if (type == IR_I16 || type == IR_U16) {
|			ASM_TXT_TXT_TMEM_OP op..w, xmm(op1-IR_REG_FP_FIRST), xmm(op2-IR_REG_FP_FIRST), oword, op3
||		} else if (type == IR_I32 || type == IR_U32) {

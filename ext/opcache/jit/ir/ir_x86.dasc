||			}
||		} else {
||			IR_ASSERT(scale == 1);
||			if (base == IR_REG_NONE) {
|				MACRO op, type, op1, [Ra(index)+offset]
||			} else {
|				MACRO op, type, op1, [Ra(base)+Ra(index)+offset]
